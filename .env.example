# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# Your production domain (used for canonical URLs, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://ihbnf.vercel.app

# "Ask IHBNF" assistant. Leave disabled (or unset) to hide it completely.
NEXT_PUBLIC_ASK_IHBNF_ENABLED=false
# Any OpenAI-compatible provider. Keep the key server-side only (no NEXT_PUBLIC_ prefix).
ASK_AI_API_KEY=
ASK_AI_MODEL=
ASK_AI_BASE_URL=https://api.openai.com/v1
